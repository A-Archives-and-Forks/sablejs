{
  "name": "sablejs",
  "version": "2.0.0",
  "description": "ES5.1 native-object ahead-of-time compiler and runtime",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime/index.js",
    "./worker": "./src/worker.js"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:differential": "node test/differential/fuzz.js --seed=1 --cases=2000 --quiet",
    "fuzz:differential": "node test/differential/fuzz.js --seed=1 --cases=100000",
    "test:unit": "node --test test/unit/*.test.js",
    "test262": "node --expose-gc test/conformance/test262.js",
    "test:e2e:build": "node test/e2e/build.js",
    "test:e2e:node": "node .cache/e2e/program.js",
    "test:e2e:deno": "deno run .cache/e2e/program.js",
    "test:e2e:bun": "bun .cache/e2e/program.js",
    "test:e2e:browsers": "playwright test --config=test/e2e/playwright.config.js",
    "benchmark": "node --expose-gc benchmark/run.js",
    "benchmark:artifacts": "node benchmark/artifacts.js",
    "benchmark:octane": "node --expose-gc benchmark/octane.js",
    "benchmark:sunspider": "node --expose-gc benchmark/sunspider.js",
    "benchmark:kraken": "node --expose-gc benchmark/kraken.js",
    "benchmark:workloads": "node --expose-gc benchmark/workloads.js",
    "benchmark:release": "node --expose-gc benchmark/release.js",
    "benchmark:smoke": "node --expose-gc benchmark/run.js --suite=Richards",
    "upstream:fetch": "node tools/fetch-upstreams.js",
    "build": "node tools/build.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sablejs/sablejs.git"
  },
  "author": "ErosZhao",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sablejs/sablejs/issues"
  },
  "homepage": "https://github.com/sablejs/sablejs#readme",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "prettier": "2.8.8",
    "quickjs-emscripten": "^0.32.0",
    "uglify-js": "3.19.3",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "chalk": "4.1.2"
  }
}
