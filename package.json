{
  "name": "sablejs",
  "version": "2.0.0-beta.5",
  "description": "ES5.1 native-object ahead-of-time compiler and runtime",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime/index.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "default": "./src/worker.js"
    }
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "types/",
    "!types/typecheck/",
    "examples/",
    "!examples/.cache/",
    "!examples/**/dist/",
    "!examples/**/out/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES",
    "logo.jpg"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:differential": "node test/differential/fuzz.js --seed=1 --cases=2000 --quiet",
    "fuzz:differential": "node test/differential/fuzz.js --seed=1 --cases=100000",
    "test:unit": "node --test test/unit/*.test.js",
    "test262": "node --expose-gc test/conformance/test262.js",
    "test:e2e:build": "node test/e2e/build.js",
    "check:types": "tsc -p types/typecheck/tsconfig.json",
    "check:examples": "node --test test/examples/*.test.js",
    "test:e2e:node": "node .cache/e2e/program.js",
    "test:e2e:deno": "deno run .cache/e2e/program.js",
    "test:e2e:bun": "bun .cache/e2e/program.js",
    "test:e2e:browsers": "playwright test --config=test/e2e/playwright.config.js",
    "benchmark": "node --expose-gc benchmark/run.js",
    "benchmark:artifacts": "node benchmark/artifacts.js",
    "benchmark:size": "node benchmark/size.js",
    "benchmark:octane": "node --expose-gc benchmark/octane.js",
    "benchmark:sunspider": "node --expose-gc benchmark/sunspider.js",
    "benchmark:kraken": "node --expose-gc benchmark/kraken.js",
    "benchmark:workloads": "node --expose-gc benchmark/workloads.js",
    "benchmark:release": "node --expose-gc benchmark/release.js",
    "benchmark:smoke": "node --expose-gc benchmark/run.js --suite=Richards",
    "upstream:fetch": "node tools/fetch-upstreams.js",
    "build": "node tools/build.js",
    "prepublishOnly": "npm run build && npm run check:compliance",
    "check:compliance": "node tools/check-compliance.js",
    "test:differential:boundary": "node test/differential/fuzz-boundary.js --seed=1 --cases=300 --quiet",
    "test262:archive": "node tools/archive-test262.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErosZy/sablejs.git"
  },
  "author": "ErosZhao",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ErosZy/sablejs/issues"
  },
  "homepage": "https://github.com/ErosZy/sablejs#readme",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.3.0",
    "esbuild": "0.28.2",
    "prettier": "2.8.8",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "5.9.3",
    "uglify-js": "3.19.3",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "acorn": "8.18.0",
    "chalk": "4.1.2"
  }
}
